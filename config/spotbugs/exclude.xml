<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
  <!-- Generated protobuf Java (test fixtures); not our code. Match package and subpackages (e.g. .v1). -->
  <Match>
    <Package name="~com\.bbrownsound\.flink\.formats\.proto\.test(\..*)?"/>
  </Match>
  <!-- Converters capture Descriptor in serializable lambda; used at job build time. -->
  <Match>
    <Class name="~com\.bbrownsound\.flink\.formats\.proto\.registry\.confluent\.serialize\.RowDataToProtoConverters\$.*"/>
    <Bug code="Se"/>
  </Match>
  <!-- The decoding format shares the planner's class loader to look up 'message-class'; by design. -->
  <Match>
    <Class name="com.bbrownsound.flink.formats.proto.registry.confluent.ProtoDecodingFormat"/>
    <Bug pattern="EI_EXPOSE_REP2"/>
  </Match>
  <!-- ProtoSqlType is a deeply immutable final class, so returning its child types exposes nothing. -->
  <Match>
    <Class name="~com\.bbrownsound\.flink\.formats\.proto\.registry\.confluent\.util\.ProtoSqlType(\$.*)?"/>
    <Bug code="EI"/>
  </Match>
  <!-- The resolver hands out the shared registry client and the protobuf Descriptor on purpose; both are meant to be shared. -->
  <Match>
    <Or>
      <Class name="com.bbrownsound.flink.formats.proto.registry.confluent.schema.ResolvedProtoSchema"/>
      <Class name="com.bbrownsound.flink.formats.proto.registry.confluent.schema.SchemaRegistrySchemaResolver"/>
    </Or>
    <Bug code="EI"/>
  </Match>
</FindBugsFilter>
