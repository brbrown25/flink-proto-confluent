#!/usr/bin/env bash
# flink-sql FILE.sql...  — runs SQL scripts on the demo cluster, concatenated in order, printing only results.
. "$(dirname "$0")/_common.sh"
cat "$@" >sql/.run.sql
docker compose cp sql jobmanager:/tmp/ >/dev/null 2>&1
docker compose exec -T jobmanager ./bin/sql-client.sh -f /tmp/sql/.run.sql 2>&1 \
  | sed $'s/\x1b\\[[0-9;]*m//g' \
  | sed -e 's/^>.*[^+-]\(+[-+]*+\)$/\1/' -e 's/^Flink SQL> //' \
  | grep -v -e '^>' -e '^$' -e 'Shutting down' -e '^done\.' -e '^WARNING' -e 'org.jline' \
      -e 'Command history' -e 'Executing SQL from file' -e 'Execute statement succeeded' -e '^Flink SQL>'
